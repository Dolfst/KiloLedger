<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>KiloLedger.Android</RootNamespace>
    <AssemblyName>KiloLedger.Android</AssemblyName>
    <ApplicationId>com.kiloledger.app</ApplicationId>
    <ApplicationTitle>KiloLedger</ApplicationTitle>
    <ApplicationVersion>13903</ApplicationVersion>
    <ApplicationDisplayVersion>1.39.3</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>disable</Nullable>
    <!-- Release signing only when all four KILOLEDGER_* values are set (environment or MSBuild). -->
    <KiloLedgerSignRelease Condition="'$(KILOLEDGER_KEYSTORE_PATH)' != '' and '$(KILOLEDGER_KEYSTORE_PASSWORD)' != '' and '$(KILOLEDGER_KEY_ALIAS)' != '' and '$(KILOLEDGER_KEY_PASSWORD)' != ''">true</KiloLedgerSignRelease>
    <AndroidKeyStore Condition="'$(KiloLedgerSignRelease)' == 'true'">true</AndroidKeyStore>
    <AndroidSigningKeyStore Condition="'$(KiloLedgerSignRelease)' == 'true'">$(KILOLEDGER_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningStorePass Condition="'$(KiloLedgerSignRelease)' == 'true'">$(KILOLEDGER_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias Condition="'$(KiloLedgerSignRelease)' == 'true'">$(KILOLEDGER_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass Condition="'$(KiloLedgerSignRelease)' == 'true'">$(KILOLEDGER_KEY_PASSWORD)</AndroidSigningKeyPass>
  </PropertyGroup>
</Project>
