<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.alfa156.mobile</ApplicationId>
    <ApplicationTitle>Alfa 156</ApplicationTitle>
    <ApplicationVersion>9</ApplicationVersion>
    <ApplicationDisplayVersion>1.7</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>disable</Nullable>
    <!-- Постоянная подпись для обновлений sideload (один ключ для CI и локальных сборок). -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)alfa156-upload.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>Alfa156Upload!</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>alfa156</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>Alfa156Upload!</AndroidSigningKeyPass>
  </PropertyGroup>
</Project>
